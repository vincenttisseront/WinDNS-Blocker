<?xml version="1.0" encoding="UTF-8"?>
<!--
  WinDNS Blocker MSI (WiX Toolset 5).

  Expects bind paths:
    ServicePublish -> ../publish/service/  (DnsBlocker.Service.exe + deps)
    UiPublish      -> ../publish/ui/       (DnsBlocker.UI.exe + deps)

  Product Version comes from MSBuild $(Version) via DefineConstants, default 1.0.0.
  UpgradeCode is stable across releases — do not change it.

  Note: WiX only fully supports Windows. Compiling this package on Linux is undefined.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="WinDNS Blocker"
    Manufacturer="WinDNS Blocker"
    Version="$(Version)"
    UpgradeCode="8F3A2C1D-9B4E-4F6A-A7C8-1D2E3F4A5B6C"
    Scope="perMachine"
    Language="1033">

    <!--
      afterInstallInitialize: remove previous product early so the service is stopped
      and old files are cleared before new files are installed (safe in-place upgrade).
    -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed. Please uninstall it first."
      AllowSameVersionUpgrades="yes"
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Icon/@Id must end with .ico/.exe or ARP and Start Menu icons often fail to resolve. -->
    <Icon Id="ProductIcon.ico" SourceFile="Assets\DnsBlocker.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon.ico" />

    <Feature Id="ProductFeature" Title="WinDNS Blocker" Description="Hub service and WPF UI" Level="1">
      <ComponentGroupRef Id="ServiceComponents" />
      <ComponentGroupRef Id="UiComponents" />
      <ComponentGroupRef Id="ToolsComponents" />
      <ComponentRef Id="AppDataRootComponent" />
      <ComponentRef Id="LogsFolderComponent" />
      <ComponentRef Id="ApplicationShortcut" />
    </Feature>

    <!-- Launch Setup GUI after interactive install.
         Prefer Property+Exe over FileKey: wixl FileKey CAs hit MSI 2753 on Server. -->
    <CustomAction Id="SetSetupAssistantPath" Property="SETUPASSISTANTEXE" Value="[UiFolder]DnsBlocker.UI.exe" />
    <CustomAction
      Id="LaunchSetupAssistant"
      Property="SETUPASSISTANTEXE"
      ExeCommand="/setup"
      Return="asyncNoWait"
      Impersonate="yes" />
    <InstallExecuteSequence>
      <Custom Action="SetSetupAssistantPath" After="InstallFiles">NOT REMOVE="ALL"</Custom>
      <Custom Action="LaunchSetupAssistant" After="InstallFinalize">NOT REMOVE="ALL" AND UILevel &gt; 2</Custom>
    </InstallExecuteSequence>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="DnsBlocker">
        <Directory Id="UiFolder" Name="UI" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="AppDataRoot" Name="DnsBlocker">
        <Directory Id="LogsFolder" Name="logs" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="WinDNS Blocker" />
    </StandardDirectory>
  </Package>

  <!-- Service binaries under Program Files\DnsBlocker -->
  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="INSTALLFOLDER">
      <Component Id="ServiceExecutable" Guid="B4E7C1A2-3D5F-4A8B-9C0D-1E2F3A4B5C6D">
        <File Id="ServiceExe" Source="!(bindpath.ServicePublish)DnsBlocker.Service.exe" KeyPath="yes" />
        <ServiceInstall
          Id="DnsBlockerServiceInstall"
          Name="DnsBlocker"
          DisplayName="WinDNS Blocker Hub"
          Description="Synchronizes Steve Jenkins-style DNS blocklists into Windows DNS Query Resolution Policies across a farm of DNS servers."
          Account="LocalSystem"
          Start="auto"
          Type="ownProcess"
          ErrorControl="normal"
          Vital="yes"
          Interactive="no" />
        <ServiceControl
          Id="DnsBlockerServiceControl"
          Name="DnsBlocker"
          Start="install"
          Stop="both"
          Remove="uninstall"
          Wait="yes" />
      </Component>
      <!-- Harvest remaining publish output (deps, dlls, json); exclude service exe (handled above). -->
      <Files Include="!(bindpath.ServicePublish)**">
        <Exclude Files="!(bindpath.ServicePublish)DnsBlocker.Service.exe" />
        <Exclude Files="!(bindpath.ServicePublish)**.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- UI under Program Files\DnsBlocker\UI -->
  <Fragment>
    <ComponentGroup Id="UiComponents" Directory="UiFolder">
      <Files Include="!(bindpath.UiPublish)**">
        <Exclude Files="!(bindpath.UiPublish)**.pdb" />
      </Files>
    </ComponentGroup>
  </Fragment>

  <!-- Tools: doctor + verify + repair next to the service -->
  <Fragment>
    <ComponentGroup Id="ToolsComponents" Directory="INSTALLFOLDER">
      <Component Id="DoctorScript" Guid="E7B0F4D5-6A8C-7D1E-2F3A-4B5C6D7E8F90">
        <File Id="DoctorPs1" Source="!(bindpath.ToolsDir)doctor.ps1" KeyPath="yes" />
      </Component>
      <Component Id="VerifyCmd" Guid="F8C1A5E6-7B9D-8E2F-3A4B-5C6D7E8F9012">
        <File Id="VerifyInstallCmd" Source="!(bindpath.ToolsDir)Verify-Install.cmd" KeyPath="yes" />
      </Component>
      <Component Id="RepairScript" Guid="A9D2B6F7-8C0E-9F3A-4B5C-6D7E8F901234">
        <File Id="RepairPs1" Source="!(bindpath.ToolsDir)Repair-DnsBlocker.ps1" KeyPath="yes" />
      </Component>
      <Component Id="RepairCmd" Guid="C1F4D8B9-0E2A-1B5C-6D7E-8F9012345678">
        <File Id="RepairDnsBlockerCmd" Source="!(bindpath.ToolsDir)Repair-DnsBlocker.cmd" KeyPath="yes" />
      </Component>
      <Component Id="RepairAliasCmd" Guid="D2A5E9C0-1F3B-2C6D-7E8F-90123456789A">
        <File Id="RepairCmdFile" Source="!(bindpath.ToolsDir)Repair.cmd" KeyPath="yes" />
      </Component>
      <Component Id="InstallWrapper" Guid="B0E3C7A8-9D1F-0A4B-5C6D-7E8F90123456">
        <File Id="InstallWrapperPs1" Source="!(bindpath.ToolsDir)Install-DnsBlocker.ps1" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ProgramData\DnsBlocker (+ logs) -->
  <Fragment>
    <Component Id="AppDataRootComponent" Directory="AppDataRoot" Guid="A1B2C3D4-5E6F-7081-92A3-B4C5D6E7F809">
      <CreateFolder />
      <RegistryValue
        Root="HKLM"
        Key="Software\DnsBlocker"
        Name="AppDataRoot"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
    <Component Id="LogsFolderComponent" Directory="LogsFolder" Guid="C5F8D2B3-4E6A-5B9C-0D1E-2F3A4B5C6D7E">
      <CreateFolder />
      <RegistryValue
        Root="HKLM"
        Key="Software\DnsBlocker"
        Name="LogsFolder"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>

  <!--
    Start Menu shortcut for the UI.
    Icon Id must match Icon/@Id (including .ico suffix). Also ensure publish copies
    DnsBlocker.ico into UiPublish and that DnsBlocker.UI.exe has an embedded icon
    (ApplicationIcon on Windows; scripts/embed-win-icon.sh after Linux cross-publish).
  -->
  <Fragment>
    <Component Id="ApplicationShortcut" Directory="ApplicationProgramsFolder" Guid="D6A9E3C4-5F7B-6C0D-1E2F-3A4B5C6D7E8F">
      <Shortcut
        Id="UiStartMenuShortcut"
        Name="WinDNS Blocker"
        Description="WinDNS Blocker Hub UI"
        Target="[UiFolder]DnsBlocker.UI.exe"
        WorkingDirectory="UiFolder"
        Icon="ProductIcon.ico"
        IconIndex="0" />
      <Shortcut
        Id="SetupStartMenuShortcut"
        Name="WinDNS Blocker Setup assistant"
        Description="Diagnose and repair (no PowerShell required)"
        Target="[UiFolder]DnsBlocker.UI.exe"
        Arguments="/setup"
        WorkingDirectory="UiFolder"
        Icon="ProductIcon.ico"
        IconIndex="0" />
      <RemoveFolder Id="RemoveApplicationProgramsFolder" Directory="ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue
        Root="HKLM"
        Key="Software\DnsBlocker"
        Name="StartMenuShortcut"
        Type="integer"
        Value="1"
        KeyPath="yes" />
    </Component>
  </Fragment>
</Wix>
