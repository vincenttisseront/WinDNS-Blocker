<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\DnsBlocker.ico</ApplicationIcon>
    <RootNamespace>DnsBlocker.UI</RootNamespace>
    <AssemblyName>DnsBlocker.UI</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnsBlocker.Core\DnsBlocker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\DnsBlocker.ico" />
    <Resource Include="Assets\windns-blocker-logo.png" />
    <Resource Include="Assets\windns-blocker-logo-64.png" />
  </ItemGroup>

</Project>
