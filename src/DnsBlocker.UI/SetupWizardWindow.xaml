<Window x:Class="DnsBlocker.UI.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Wizard.Title}"
        Height="560" Width="720"
        MinHeight="480" MinWidth="640"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel Margin="20">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
            BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{DynamicResource Wizard.Header}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="StepTitle" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#0B6E4F"/>
        <TextBlock x:Name="StepSubtitle" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <ProgressBar x:Name="BusyBar" Height="6" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BackButton" Content="{DynamicResource Btn.Back}" Click="Back_Click" Margin="0,0,8,0"/>
      <Button x:Name="SkipButton" Content="{DynamicResource Btn.Skip}" Click="Skip_Click" Margin="0,0,8,0"/>
      <Button x:Name="NextButton" Content="{DynamicResource Btn.Next}" Click="Next_Click" FontWeight="SemiBold"/>
    </StackPanel>

    <Grid>
      <StackPanel x:Name="StepWelcome" Visibility="Visible">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,12" Text="{DynamicResource Wizard.WelcomeBody}"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="12">
          <StackPanel>
            <TextBlock x:Name="WelcomeServiceStatus" FontWeight="SemiBold"/>
            <TextBlock x:Name="WelcomeDomainStatus" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}"/>
            <StackPanel x:Name="RepairPanel" Margin="0,12,0,0" Visibility="Collapsed">
              <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Wizard.RepairBody}"/>
              <Button x:Name="RepairButton" Content="{DynamicResource Btn.RepairInstall}" Click="Repair_Click" HorizontalAlignment="Left"/>
              <TextBlock x:Name="RepairHint" Margin="0,6,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>

      <StackPanel x:Name="StepTargets" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Wizard.TargetsBody}"/>
        <TextBlock x:Name="TargetsDomainHint" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBox x:Name="TargetsBox" AcceptsReturn="True" Height="160" VerticalScrollBarVisibility="Auto"
                 TextWrapping="NoWrap" FontFamily="Consolas"/>
      </StackPanel>

      <StackPanel x:Name="StepLists" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Wizard.ListsBody}"/>
        <TextBlock Text="{DynamicResource Wizard.BlocklistsLol}" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="BlocklistsUrlBox"/>
        <TextBlock Text="{DynamicResource Wizard.WhitelistsLol}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <TextBox x:Name="WhitelistsUrlBox"/>
        <TextBlock Text="{DynamicResource Cfg.PolicyAction}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <ComboBox x:Name="ActionBox" Width="160" HorizontalAlignment="Left">
          <ComboBoxItem Content="DENY"/>
          <ComboBoxItem Content="IGNORE" IsSelected="True"/>
        </ComboBox>
      </StackPanel>

      <StackPanel x:Name="StepUpdates" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Wizard.UpdatesBody}"/>
        <TextBlock Text="{DynamicResource Wizard.VersionJsonUrl}" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="UpdateFeedUrlBox"/>
        <CheckBox x:Name="CheckUpdatesOnStartupBox" Content="{DynamicResource Cfg.CheckUpdatesStartup}" Margin="0,12,0,4" IsChecked="True"/>
        <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="{DynamicResource Wizard.UpdatesExample}"/>
      </StackPanel>

      <StackPanel x:Name="StepConfirm" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Wizard.ConfirmBody}"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="12">
          <TextBlock x:Name="ConfirmSummary" TextWrapping="Wrap" FontFamily="Consolas"/>
        </Border>
        <CheckBox x:Name="ApplyNowBox" Content="{DynamicResource Wizard.ApplyNow}" Margin="0,12,0,0" IsChecked="True"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
