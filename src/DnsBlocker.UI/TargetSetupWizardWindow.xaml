<Window x:Class="DnsBlocker.UI.TargetSetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Target.Title}"
        Height="640" Width="760"
        MinHeight="520" MinWidth="680"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel Margin="20">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}"
            BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,16">
      <StackPanel>
        <TextBlock Text="{DynamicResource Target.Header}" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock x:Name="StepTitle" Margin="0,6,0,0" FontWeight="SemiBold" Foreground="#0B6E4F"/>
        <TextBlock x:Name="StepSubtitle" Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        <ProgressBar x:Name="BusyBar" Height="6" Margin="0,12,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
      </StackPanel>
    </Border>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button x:Name="BackButton" Content="{DynamicResource Btn.Back}" Click="Back_Click" Margin="0,0,8,0"/>
      <Button x:Name="NextButton" Content="{DynamicResource Btn.Next}" Click="Next_Click" FontWeight="SemiBold"/>
    </StackPanel>

    <Grid>
      <StackPanel x:Name="StepHost" Visibility="Visible">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Target.HostBody}"/>
        <TextBlock x:Name="DomainHint" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
        <TextBlock Text="{DynamicResource Target.DnsServer}" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HostnameBox"/>
        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="{DynamicResource Target.HostHint}"/>
      </StackPanel>

      <StackPanel x:Name="StepCreds" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Target.CredsBody}"/>
        <TextBlock Text="{DynamicResource Target.Account}" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="UsernameBox"/>
        <TextBlock Text="{DynamicResource Target.Password}" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/>
        <PasswordBox x:Name="PasswordBox" Padding="8,6" Margin="0,0,0,8"/>
        <CheckBox x:Name="PersistCredsBox" Content="{DynamicResource Target.PersistCreds}" IsChecked="True" Margin="0,4,0,4"/>
        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                   Text="{DynamicResource Target.CredsHint}"/>
      </StackPanel>

      <StackPanel x:Name="StepTest" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Target.TestBody}"/>
        <TextBlock Text="{DynamicResource Target.HubIdentity}" Foreground="{StaticResource MutedBrush}"/>
        <TextBox x:Name="HubIdentityBox"/>
        <CheckBox x:Name="AddDnsAdminsBox" Margin="0,8,0,8"
                  Content="{DynamicResource Target.AddDnsAdmins}"/>
        <Button x:Name="TestWinRmButton" Content="{DynamicResource Btn.TestWinRm}" Click="TestWinRm_Click" HorizontalAlignment="Left" Margin="0,0,0,8"/>
        <TextBlock x:Name="TestStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,8,0,0" MaxHeight="180">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="ActionLogBox" FontFamily="Consolas" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
      </StackPanel>

      <StackPanel x:Name="StepApply" Visibility="Collapsed">
        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8" Text="{DynamicResource Target.ApplyBody}"/>
        <Button x:Name="PrepareButton" Content="{DynamicResource Btn.PrepareTargetAction}" Click="Prepare_Click" HorizontalAlignment="Left" FontWeight="SemiBold" Margin="0,0,0,8"/>
        <TextBlock x:Name="PrepareStatus" TextWrapping="Wrap" FontWeight="SemiBold"/>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1"
                CornerRadius="6" Padding="10" Margin="0,8,0,0" MaxHeight="220">
          <ScrollViewer VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="PrepareLogBox" FontFamily="Consolas" TextWrapping="Wrap"/>
          </ScrollViewer>
        </Border>
        <CheckBox x:Name="AddToFarmBox" Content="{DynamicResource Target.AddToFarm}" IsChecked="True" Margin="0,12,0,0"/>
      </StackPanel>
    </Grid>
  </DockPanel>
</Window>
