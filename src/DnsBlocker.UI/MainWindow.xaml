<Window x:Class="DnsBlocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource AppName}"
        Icon="pack://application:,,,/Assets/DnsBlocker.ico"
        Height="720" Width="1080"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <Image Source="pack://application:,,,/Assets/windns-blocker-logo-64.png"
                   Width="40" Height="40" Margin="0,0,12,0"
                   Stretch="Uniform" SnapsToDevicePixels="True"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="{DynamicResource AppName}" FontSize="22" FontWeight="SemiBold" Foreground="#123"/>
                <TextBlock x:Name="VersionLabel" Text="" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,2"
                           Foreground="{StaticResource MutedBrush}"/>
              </StackPanel>
              <TextBlock Text="{DynamicResource Hero.Subtitle}" Foreground="{StaticResource MutedBrush}" Margin="0,2,0,0"/>
            </StackPanel>
          </StackPanel>
          <TextBlock x:Name="UpdateStatusLine" Text="" Foreground="{StaticResource MutedBrush}" Margin="52,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar x:Name="BusyBar" Width="120" Height="8" Margin="0,0,12,0"
                       IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
          <TextBlock x:Name="BusyLabel" Text="" Margin="0,0,8,0" VerticalAlignment="Center"
                     Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
          <Button x:Name="SyncCancelButton" Content="{DynamicResource Btn.CancelSync}" Click="SyncCancel_Click"
                  Margin="0,0,6,0" Visibility="Collapsed" Padding="8,4"/>
          <Button x:Name="SyncBackgroundButton" Content="{DynamicResource Btn.SyncBackground}" Click="SyncBackground_Click"
                  Margin="0,0,12,0" Visibility="Collapsed" Padding="8,4"/>
          <Button x:Name="WizardButton" Content="{DynamicResource Btn.Wizard}" Click="Wizard_Click" Margin="0,0,8,0"/>
          <Button x:Name="RefreshButton" Content="{DynamicResource Btn.Refresh}" Click="Refresh_Click"/>
          <Button x:Name="CheckUpdatesButton" Content="{DynamicResource Btn.CheckUpdates}" Click="CheckUpdates_Click"/>
          <Button x:Name="ApplyNowButton" Content="{DynamicResource Btn.ApplyNow}" Click="ApplyNow_Click" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl x:Name="MainTabs" Background="Transparent" BorderThickness="0">
      <TabItem Header="{DynamicResource Tab.Status}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="StatusSummary" Text="{DynamicResource Status.Connecting}" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetails" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <StackPanel x:Name="ServiceHelpPanel" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                  <Button x:Name="StartServiceButton" Content="{DynamicResource Btn.StartService}" Click="StartService_Click"/>
                  <Button Content="{DynamicResource Btn.RetryConnection}" Click="Refresh_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Status.LastSyncTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock x:Name="SucceededHintText" Text="{DynamicResource Status.SucceededHint}"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrushKey}"
                      VerticalAlignment="Top" MaxHeight="220" Margin="0,0,0,16">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Server}" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Kind}" Binding="{Binding Kind}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.SyncStatus}" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.PoliciesSync}" Binding="{Binding PolicyCount}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Duration}" Binding="{Binding Duration}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Error}" Binding="{Binding Error}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>

            <!-- Verify lives next to the live probe (not Last sync) so the CTA matches Status.NoProbeYet. -->
            <DockPanel Margin="0,0,0,4" LastChildFill="True">
              <Button x:Name="VerifyPoliciesButton" DockPanel.Dock="Right" Content="{DynamicResource Btn.VerifyPolicies}"
                      Click="VerifyPolicies_Click" Margin="8,0,0,0" VerticalAlignment="Center"/>
              <TextBlock Text="{DynamicResource Status.LivePoliciesTitle}" FontWeight="SemiBold" VerticalAlignment="Center"
                         TextWrapping="Wrap"/>
            </DockPanel>
            <TextBlock x:Name="PolicyProbeSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="{DynamicResource Status.NoProbeYet}"/>
            <!-- Empty DataGrid inside ScrollViewer otherwise measures to a huge viewport-tall void. -->
            <DataGrid x:Name="PolicyStatusGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrushKey}"
                      VerticalAlignment="Top" Height="40" MinHeight="0" MaxHeight="200" Margin="0,0,0,8"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      ScrollViewer.CanContentScroll="True">
              <DataGrid.Columns>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Server}" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Kind}" Binding="{Binding Kind}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Applied}" Binding="{Binding AppliedLabel}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Installed}" Binding="{Binding LivePolicyCount}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.Enabled}" Binding="{Binding LiveEnabledCount}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.LastSync}" Binding="{Binding LastSyncPolicyCount}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.SyncStatus}" Binding="{Binding LastSyncStatus}" Width="*"/>
                <DataGridTextColumn Header="{DynamicResource Status.Col.ProbeError}" Binding="{Binding ProbeError}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>

            <!-- Content-sized card (not a stretch fill). Full #EEF6F0 fill previously read as a huge empty green panel
                 when BlockTest strings were missing and the empty PolicyStatusGrid expanded above. -->
            <Border x:Name="BlockTestPanel" Background="{StaticResource PanelBrush}" BorderBrush="#2E7D4F"
                    BorderThickness="3,1,1,1" CornerRadius="4" Padding="12" Margin="0,8,0,8"
                    VerticalAlignment="Top" HorizontalAlignment="Stretch">
              <StackPanel>
                <TextBlock Text="{DynamicResource Status.BlockTestTitle}" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Status.BlockTestHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                  <TextBox x:Name="BlockTestDomainBox" Width="280" MinWidth="160" Margin="0,0,8,0" ToolTip="beeg.com"
                           VerticalAlignment="Center"/>
                  <Button x:Name="BlockTestButton" Content="{DynamicResource Btn.TestBlock}" Click="TestBlock_Click"
                          FontWeight="SemiBold" Padding="16,6" MinWidth="120" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="BlockTestResultText" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <TextBlock Text="{DynamicResource Status.ActionLog}" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox x:Name="StatusActionLogBox" IsReadOnly="True" AcceptsReturn="True" Height="90"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="{DynamicResource Tab.Configuration}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Cfg.Language}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.LanguageHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <ComboBox x:Name="LanguageBox" Width="280" HorizontalAlignment="Left" SelectionChanged="LanguageBox_SelectionChanged">
                  <ComboBoxItem x:Name="LangAutoItem" Tag="auto"/>
                  <ComboBoxItem x:Name="LangEnItem" Tag="en"/>
                  <ComboBoxItem x:Name="LangFrItem" Tag="fr"/>
                </ComboBox>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Cfg.SourcesTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.BlocklistsUrl}" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="BlocklistsUrlBox"/>
                <TextBlock Text="{DynamicResource Cfg.BlocklistsUrlHint}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.WhitelistsUrl}" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="WhitelistsUrlBox"/>
                <TextBlock Text="{DynamicResource Cfg.RegexUrl}" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RegexUrlBox" IsReadOnly="True" Opacity="0.7"/>
                <TextBlock Text="{DynamicResource Cfg.CuratedTitle}" FontWeight="SemiBold" Margin="0,12,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.CuratedHint}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <CheckBox x:Name="CuratedYoutubeAdsCheck" Content="{DynamicResource Cfg.CuratedYoutube}" Margin="0,0,0,4"/>
                <CheckBox x:Name="CuratedOisdBigCheck" Content="{DynamicResource Cfg.CuratedOisdBig}" Margin="0,0,0,4"/>
                <CheckBox x:Name="CuratedOisdNsfwCheck" Content="{DynamicResource Cfg.CuratedOisdNsfw}" Margin="0,0,0,4"/>
                <CheckBox x:Name="CuratedChadmayfieldCheck" Content="{DynamicResource Cfg.CuratedChad}" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.ExtraUrls}" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="ExtraBlocklistUrlsBox" AcceptsReturn="True" Height="72" VerticalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap" Margin="0,0,0,8"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Cfg.PolicyAction}" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="ActionBox">
                      <ComboBoxItem Content="DENY"/>
                      <ComboBoxItem Content="IGNORE"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Cfg.ChunkSize}" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="ChunkSizeBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Cfg.Parallel}" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="ParallelBox"/>
                  </StackPanel>
                </Grid>
                <Grid Margin="0,8,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Cfg.MaxDomains}" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="MaxDomainsBox"/>
                    <TextBlock Text="{DynamicResource Cfg.MaxDomainsHint}"
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{DynamicResource Cfg.ScheduleHour}" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBox x:Name="HourBox" Width="60" Margin="0,0,8,0"/>
                      <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,8"/>
                      <TextBox x:Name="MinuteBox" Width="60"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <CheckBox x:Name="StatsCheck" Content="{DynamicResource Cfg.EnableStats}" Margin="0,0,0,8"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Cfg.UpdatesTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.UpdateFeedUrl}" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="UpdateFeedUrlBox"/>
                <TextBlock Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                           Text="{DynamicResource Cfg.UpdateFeedDefaultHint}"/>
                <CheckBox x:Name="CheckUpdatesOnStartupBox" Content="{DynamicResource Cfg.CheckUpdatesStartup}" Margin="0,8,0,4"/>
                <CheckBox x:Name="AutoInstallUpdatesBox" Content="{DynamicResource Cfg.AutoInstall}" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource Cfg.UpdatesHint}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Cfg.FarmTitle}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="{DynamicResource Cfg.FarmHint}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="TargetsBox" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                <TextBlock Text="{DynamicResource Cfg.AddLocalDnsHint}"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="{DynamicResource Btn.SaveConfig}" Click="SaveConfig_Click"/>
                  <Button Content="{DynamicResource Btn.AddLocalDns}" Click="AddLocalDns_Click"/>
                  <Button Content="{DynamicResource Btn.PrepareTarget}" Click="TargetWizard_Click"/>
                </StackPanel>
                <TextBlock x:Name="PreparedTargetsSummary" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem x:Name="DomainsTabItem" Header="{DynamicResource Tab.Domains}">
        <DockPanel Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="DomainHintLabel" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" TextWrapping="Wrap"/>
            <StackPanel Orientation="Horizontal">
              <Grid Width="360" Margin="0,0,8,0">
                <TextBox x:Name="DomainSearchBox" Padding="8,6"/>
                <TextBlock x:Name="DomainSearchPlaceholder"
                           Text="{DynamicResource Domains.Placeholder}"
                           Foreground="#9AA8B5" Margin="10,8,0,0" IsHitTestVisible="False"
                           Visibility="Collapsed"/>
              </Grid>
              <Button x:Name="SearchDomainsButton" Content="{DynamicResource Btn.Search}" Click="SearchDomains_Click"/>
              <ProgressBar x:Name="DomainSearchBusy" Width="80" Height="8" Margin="12,0,0,0"
                           IsIndeterminate="True" Visibility="Collapsed" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock x:Name="DomainSearchStatus" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <Grid>
            <ListBox x:Name="DomainsList" BorderBrush="{StaticResource BorderBrushKey}"/>
            <TextBlock x:Name="DomainsEmptyLabel"
                       Text="{DynamicResource Domains.Empty}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}" Visibility="Collapsed"/>
          </Grid>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Tab.Logs}">
        <DockPanel Margin="0,12,0,0">
          <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
              <Button x:Name="CopyLogsButton" Content="{DynamicResource Btn.CopyLogs}"
                      Click="CopyLogs_Click" FontWeight="SemiBold" MinWidth="120" Padding="12,4"/>
              <TextBlock x:Name="CopyLogsFeedback" VerticalAlignment="Center" Margin="10,0,0,0"
                         Foreground="#2E7D32" FontWeight="SemiBold" Visibility="Collapsed"/>
            </StackPanel>
            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}"
                       Text="{DynamicResource Logs.Hint}" TextWrapping="Wrap"/>
          </DockPanel>
          <TextBox x:Name="LogsBox" IsReadOnly="True" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                   FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="{DynamicResource Tab.Stats}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="{DynamicResource Stats.CollectionHint}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                  <Button x:Name="EnableStatsButton" Content="{DynamicResource Btn.EnableStats}" Click="EnableStats_Click" Margin="0,0,8,0"/>
                  <TextBlock x:Name="StatsCollectionStatus" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="{DynamicResource Stats.Period}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox x:Name="StatsHoursBox" Width="60" Text="24" Margin="0,0,8,0"/>
                  <TextBlock Text="{DynamicResource Stats.TopN}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="StatsTopNBox" Width="72" Margin="0,0,8,0" SelectedIndex="1">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                  </ComboBox>
                  <Button x:Name="LoadStatsButton" Content="{DynamicResource Btn.Load}" Click="LoadStats_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatsSummary" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatsMessage" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="{DynamicResource Stats.YoutubeCaveat}"/>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="{DynamicResource Stats.TopQueried}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopQueriedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Domain}" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Hits}" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="{DynamicResource Stats.TopBlocked}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopBlockedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Domain}" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Hits}" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="{DynamicResource Stats.TopClients}" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopClientsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Client}" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="{DynamicResource Stats.Col.Hits}" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Grid>
            <TextBlock Text="{DynamicResource Stats.ActionLog}" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="StatsActionLogBox" IsReadOnly="True" AcceptsReturn="True" Height="72"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
