<Window x:Class="DnsBlocker.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinDNS Blocker"
        Height="760" Width="1120"
        MinHeight="560" MinWidth="860"
        Background="{StaticResource BgBrush}"
        FontFamily="Segoe UI"
        FontSize="13">
  <DockPanel Margin="16">
    <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="WinDNS Blocker" FontSize="22" FontWeight="SemiBold" Foreground="#123"/>
            <TextBlock x:Name="VersionLabel" Text="" FontSize="14" VerticalAlignment="Bottom" Margin="12,0,0,2"
                       Foreground="{StaticResource MutedBrush}"/>
          </StackPanel>
          <TextBlock Text="Hub unique → politiques QRP sur X serveurs DNS" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
          <TextBlock x:Name="UpdateStatusLine" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
          <ProgressBar x:Name="BusyBar" Height="6" Margin="0,10,0,0" IsIndeterminate="True" Visibility="Collapsed"/>
          <TextBlock x:Name="BusyLabel" Text="" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" Visibility="Collapsed"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <Button x:Name="RefreshButton" Content="Actualiser" Click="Refresh_Click"/>
          <Button x:Name="CheckUpdatesButton" Content="Vérifier les mises à jour" Click="CheckUpdates_Click"/>
          <Button x:Name="ApplyNowButton" Content="Mettre à jour maintenant" Click="ApplyNow_Click" FontWeight="SemiBold"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl Background="Transparent" BorderThickness="0">
      <TabItem Header="Statut">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="StatusSummary" Text="Connexion au service…" FontWeight="SemiBold"/>
                <TextBlock x:Name="StatusDetails" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>

            <DockPanel Margin="0,0,0,8">
              <Button x:Name="VerifyPoliciesButton" DockPanel.Dock="Right" Content="Vérifier les politiques QRP"
                      Click="VerifyPolicies_Click" Margin="8,0,0,0"/>
              <TextBlock Text="Dernière sync (poussée hub → DNS)" FontWeight="SemiBold" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBlock Text="Le statut « Succeeded » indique que le hub a poussé des chunks — pas que les politiques sont encore présentes/activées sur le serveur."
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
            <DataGrid x:Name="TargetsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrushKey}"
                      Margin="0,0,0,16">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serveur" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="Statut sync" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Politiques (sync)" Binding="{Binding PolicyCount}" Width="*"/>
                <DataGridTextColumn Header="Durée" Binding="{Binding Duration}" Width="*"/>
                <DataGridTextColumn Header="Erreur" Binding="{Binding Error}" Width="3*"/>
              </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="Politiques QRP installées (sonde live Get-DnsServerQueryResolutionPolicy)" FontWeight="SemiBold" Margin="0,0,0,4"/>
            <TextBlock x:Name="PolicyProbeSummary" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Aucune sonde encore — cliquez « Vérifier les politiques QRP »."/>
            <DataGrid x:Name="PolicyStatusGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      CanUserAddRows="False" GridLinesVisibility="Horizontal" BorderBrush="{StaticResource BorderBrushKey}"
                      Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Serveur" Binding="{Binding Target}" Width="2*"/>
                <DataGridTextColumn Header="Application" Binding="{Binding AppliedLabel}" Width="*"/>
                <DataGridTextColumn Header="Installées" Binding="{Binding LivePolicyCount}" Width="*"/>
                <DataGridTextColumn Header="Activées" Binding="{Binding LiveEnabledCount}" Width="*"/>
                <DataGridTextColumn Header="Sync (dernier)" Binding="{Binding LastSyncPolicyCount}" Width="*"/>
                <DataGridTextColumn Header="Statut sync" Binding="{Binding LastSyncStatus}" Width="*"/>
                <DataGridTextColumn Header="Erreur sonde" Binding="{Binding ProbeError}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="Journal d'actions (Statut)" FontWeight="SemiBold" Margin="0,8,0,4"/>
            <TextBox x:Name="StatusActionLogBox" IsReadOnly="True" AcceptsReturn="True" Height="90"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Configuration">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Sources de listes" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="URL blocklists.txt (liste de listes)" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="BlocklistsUrlBox"/>
                <TextBlock Text="URL whitelists.txt" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="WhitelistsUrlBox"/>
                <TextBlock Text="regex.txt (non supporté par Windows DNS QRP — informatif)" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="RegexUrlBox" IsReadOnly="True" Opacity="0.7"/>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Action QRP" Foreground="{StaticResource MutedBrush}"/>
                    <ComboBox x:Name="ActionBox">
                      <ComboBoxItem Content="DENY"/>
                      <ComboBoxItem Content="IGNORE"/>
                    </ComboBox>
                  </StackPanel>
                  <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Taille de paquet FQDN" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="ChunkSizeBox"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="Parallélisme cibles" Foreground="{StaticResource MutedBrush}"/>
                    <TextBox x:Name="ParallelBox"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="Heure sync quotidienne (locale)" Foreground="{StaticResource MutedBrush}"/>
                    <StackPanel Orientation="Horizontal">
                      <TextBox x:Name="HourBox" Width="60" Margin="0,0,8,0"/>
                      <TextBlock Text=":" VerticalAlignment="Center" Margin="0,0,8,8"/>
                      <TextBox x:Name="MinuteBox" Width="60"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,8">
                    <CheckBox x:Name="StatsCheck" Content="Activer la collecte de stats (ETW DNS)" Margin="0,0,0,8"/>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Mises à jour de l'application" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="URL du flux version.json" Foreground="{StaticResource MutedBrush}"/>
                <TextBox x:Name="UpdateFeedUrlBox"/>
                <CheckBox x:Name="CheckUpdatesOnStartupBox" Content="Vérifier les mises à jour au démarrage" Margin="0,8,0,4"/>
                <CheckBox x:Name="AutoInstallUpdatesBox" Content="Installer automatiquement (service silencieux msiexec /qn)" Margin="0,0,0,4"/>
                <TextBlock Text="Sans installation auto, seule une notification est affichée. L'installation depuis l'UI passe par le service (déjà élevé) ; un installateur local utiliserait UAC (runas)."
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>

            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock Text="Farm DNS (cibles du hub)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <TextBlock Text="Un hostname / FQDN par ligne. Le service pousse les politiques vers chaque cible via WinRM. Exemple prod : windc05.ar-systems.fr"
                           Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBox x:Name="TargetsBox" AcceptsReturn="True" Height="120" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="Enregistrer la configuration" Click="SaveConfig_Click"/>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Domaines">
        <DockPanel Margin="0,12,0,0">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBox x:Name="DomainSearchBox" Width="320" Margin="0,0,8,0"/>
            <Button Content="Rechercher" Click="SearchDomains_Click"/>
          </StackPanel>
          <ListBox x:Name="DomainsList" BorderBrush="{StaticResource BorderBrushKey}"/>
        </DockPanel>
      </TabItem>

      <TabItem Header="Logs">
        <TextBox x:Name="LogsBox" Margin="0,12,0,0" IsReadOnly="True" AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                 FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
      </TabItem>

      <TabItem Header="Stats">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
          <StackPanel>
            <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrushKey}" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal">
                  <TextBlock Text="Période (heures) :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <TextBox x:Name="StatsHoursBox" Width="60" Text="24" Margin="0,0,8,0"/>
                  <TextBlock Text="Top N :" VerticalAlignment="Center" Margin="0,0,8,0"/>
                  <ComboBox x:Name="StatsTopNBox" Width="72" Margin="0,0,8,0" SelectedIndex="1">
                    <ComboBoxItem Content="10"/>
                    <ComboBoxItem Content="20"/>
                  </ComboBox>
                  <Button x:Name="LoadStatsButton" Content="Charger" Click="LoadStats_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatsSummary" Margin="0,12,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="StatsMessage" Margin="0,8,0,0" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"
                           Text="Limite importante : les pubs YouTube contournent souvent un blocage DNS pur (mêmes hôtes que le CDN vidéo). Les tops ci-dessous servent à vérifier que le hub enregistre bien des requêtes / domaines de listes — pas à garantir zéro pub mobile."/>
              </StackPanel>
            </Border>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel Margin="0,0,8,0">
                <TextBlock Text="Top domaines appelés" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopQueriedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Domaine" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="Hits" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="0,0,8,0">
                <TextBlock Text="Top domaines bloqués" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopBlockedGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Domaine" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="Hits" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Top clients (bloqués)" FontWeight="SemiBold" Margin="0,0,0,8"/>
                <DataGrid x:Name="TopClientsGrid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" CanUserAddRows="False">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Client" Binding="{Binding Key}" Width="3*"/>
                    <DataGridTextColumn Header="Hits" Binding="{Binding Count}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Grid>
            <TextBlock Text="Journal d'actions (Stats)" FontWeight="SemiBold" Margin="0,12,0,4"/>
            <TextBox x:Name="StatsActionLogBox" IsReadOnly="True" AcceptsReturn="True" Height="72"
                     VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                     FontFamily="Consolas" Background="{StaticResource PanelBrush}"/>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
