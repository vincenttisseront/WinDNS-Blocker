  <sys:String x:Key="Wizard.RepairBody">Incomplete install or service unavailable. Use guided repair (no command line).</sys:String>
  <sys:String x:Key="Wizard.TargetsBody">Enter the Windows DNS servers that will receive QRP policies (one FQDN or hostname per line).</sys:String>
  <sys:String x:Key="Wizard.ListsBody">Steve Jenkins list-of-lists URLs. Defaults work for most deployments.</sys:String>
