  <sys:String x:Key="Cfg.CuratedTitle">Listes supplémentaires (curated)</sys:String>
  <sys:String x:Key="Cfg.CuratedHint">Rechargées à chaque sync quotidienne (heure ci-dessous) et via « Mettre à jour maintenant ».</sys:String>
  <sys:String x:Key="Cfg.CuratedYoutube">YouTube ads (pi-hole list — kboghdady)</sys:String>
  <sys:String x:Key="Cfg.CuratedOisdBig">OISD big (ads / trackers)</sys:String>
  <sys:String x:Key="Cfg.CuratedOisdNsfw">OISD NSFW (famille / faible FP)</sys:String>
  <sys:String x:Key="Cfg.CuratedChad">Chadmayfield porn (adulte, ~1,9M — opt-in)</sys:String>
  <sys:String x:Key="Cfg.ExtraUrls">URLs extra personnalisées (une par ligne, en plus des curated)</sys:String>
  <sys:String x:Key="Cfg.PolicyAction">Action QRP</sys:String>
